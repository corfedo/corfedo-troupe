<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Deterministic>true</Deterministic>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Authors>Wojciech Wentland</Authors>
    <Copyright>Copyright 2026 Wojciech Wentland</Copyright>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version>0.1.0-alpha.4</Version>
    <RepositoryUrl>https://github.com/corfedo/corfedo-troupe</RepositoryUrl>
    <PackageProjectUrl>https://github.com/corfedo/corfedo-troupe</PackageProjectUrl>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="" />
    <None Include="$(MSBuildThisFileDirectory)NOTICE" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
